!> @brief Conversion between physical wind on faces and prognostic u in LFRic
!> @details
module convert_w2_wind_alg_mod

  use config_mod,                        only: config_type
  use constants_mod,                     only: i_def, r_def, l_def
  use mesh_mod,                          only: mesh_type
  use field_mod,                         only: field_type
  use integer_field_mod,                 only: integer_field_type
  use sci_geometric_constants_mod,       only: get_coordinates,      &
                                               get_panel_id,         &
                                               get_face_selector_ew, &
                                               get_face_selector_ns
  use sci_geometric_constants_mod,       only: get_dA_at_w2
  use log_mod,                           only: log_event, log_scratch_space, &
                                               LOG_LEVEL_ERROR
  use convert_w2_wind_metric_kernel_mod, only: &
                                              convert_w2_wind_metric_kernel_type
  use convert_w2_wind_strict_kernel_mod, only: &
                                              convert_w2_wind_strict_kernel_type
  use finite_element_config_mod,         only: coord_system_native
  use mixing_config_mod,                 only: w_conversion_simple, &
                                               w_conversion_metric, &
                                               w_conversion_strict

  implicit none

  private
  public :: convert_w2_wind_alg

contains

  !> @details Do conversion between physical wind on faces and
  !>          prognostic u in LFRic
  !> @param[in]     config            Application namelist configuration object
  !> @param[in,out] u_out             Output W2 wind field
  !> @param[in,out] u_in              Input W2 wind field
  !> @param[in,out] prog_to_phys      Switch for conversion direction
  subroutine convert_w2_wind_alg(config, u_out, u_in, prog_to_phys)

    implicit none

    type(config_type), intent(in)    :: config
    type(field_type),  intent(inout) :: u_out
    type(field_type),  intent(in)    :: u_in
    logical(l_def),    intent(in)    :: prog_to_phys

    type(field_type),         pointer :: chi(:)
    type(field_type),         pointer :: dA
    type(field_type),         pointer :: panel_id
    type(integer_field_type), pointer :: face_selector_ew
    type(integer_field_type), pointer :: face_selector_ns
    type(mesh_type),          pointer :: mesh

    integer(i_def) :: coord_system, geometry, topology
    real(r_def)    :: scaled_radius

    mesh             => u_in % get_mesh()
    chi              => get_coordinates( mesh )
    dA               => get_dA_at_w2( mesh )
    panel_id         => get_panel_id( mesh )
    face_selector_ew => get_face_selector_ew( mesh )
    face_selector_ns => get_face_selector_ns( mesh )

    coord_system  = config % finite_element % coord_system()
    geometry      = config % base_mesh % geometry()
    topology      = config % base_mesh % topology()
    scaled_radius = config % planet % scaled_radius()

    select case (config % mixing % w_conversion())
    case (w_conversion_simple)
      if (prog_to_phys) then
        call invoke( X_divideby_Y(u_out, u_in, dA) )
      else
        call invoke( X_times_Y(u_out, u_in, dA) )
      end if
    case (w_conversion_metric)
      call invoke( convert_w2_wind_metric_kernel_type(u_out, u_in,             &
                                                      dA, chi(3),              &
                                                      face_selector_ew,        &
                                                      face_selector_ns,        &
                                                      prog_to_phys) )
    case (w_conversion_strict)
      if (coord_system /= coord_system_native .or.                             &
          u_in % get_element_order_h() /= 0 .or.                               &
          u_in % get_element_order_v() /= 0) then
        write(log_scratch_space,'(A)')                                    &
          'Strict wind conversion supports only native coordinate'//           &
          ' and minimum order W2 field.'
        call log_event( log_scratch_space, LOG_LEVEL_ERROR )
      end if

      call invoke( convert_w2_wind_strict_kernel_type(u_out, u_in, dA,         &
                                                      chi(1), chi(2), chi(3),  &
                                                      panel_id,                &
                                                      face_selector_ew,        &
                                                      face_selector_ns,        &
                                                      coord_system,            &
                                                      geometry, topology,      &
                                                      scaled_radius,           &
                                                      prog_to_phys) )
    case default
      write(log_scratch_space,'(A)')                                    &
        'Not supported wind conversion method.'
      call log_event( log_scratch_space, LOG_LEVEL_ERROR )
    end select

    nullify(chi, dA, panel_id, face_selector_ew, face_selector_ns, mesh)

  end subroutine convert_w2_wind_alg

end module convert_w2_wind_alg_mod
